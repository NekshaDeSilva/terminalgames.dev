using ppp = pair<ll, int>;

#define pb(x) push_back(x)
#define eb(x) emplace_back(x)
#define s(x) sort((x).begin(), (x).end())

const int maxn = 200005;
vector<int> graphlist[maxn];
ll difflist[maxn];
ll subsums[maxn];
int degree[maxn];
bool alive[maxn];

vector<int> curpath;
vector<int> bestpath;
ll maxsum = numeric_limits<ll>::min() ;

void dfsiz(int curnode, int parnode) {
    subsums[curnode] = difflist[curnode];
    for (int nxtnode : graphlist[curnode]) {
        
        if (nxtnode != parnode && alive[nxtnode]) {
            dfsiz(nxtnode, curnode);
            subsums[curnode] += subsums[nxtnode];
        }
    }
}

void dfsgen(int curnode, int parnode, bool ret) {
    curpath.pb(curnode);
    
    vector<ppp> childs;
    for (int nxtnode : graphlist[curnode]) {
        if (nxtnode != parnode && alive[nxtnode]){
             childs.pb({subsums[nxtnode], nxtnode});
        }
    }
    
    sort(childs.rbegin(), childs.rend());

    for (int i =0;  i < (int)childs.size(); i ++) {
        
        int nxtnode = childs[i].second;
        bool needret = ret || (i < (int)childs.size() - 1);
        
        dfsgen(nxtnode, curnode, needret);
        
        if (needret){


            curpath.pb(curnode);
        }
    }
}

pair<vector<int>, vector<ll>> find_rebalancing_strategy(
    int numofvals, vector<int> lista, vector<int> listb, vector<int> listu, vector<int> listv) {
  
    
    for (int i =0;  i < numofvals; i ++) {
        graphlist[i].clear();
        alive[i] = 1;
        degree[i] = 0;
        difflist[i] = (ll)lista[i] - listb[i];
    }
    
    for (int i =0;  i < numofvals - 1; i ++) {
        graphlist[listu[i]].pb(listv[i]);
        graphlist[listv[i]].pb(listu[i]);

        degree[listu[i]]++ ;
        degree[listv[i]]++;
    }

    queue<int> q;
    for (int i =0;  i < numofvals; i ++) {
        if (degree[i] == 1 && difflist[i] == 0){
             q.push(i);
        }
    }

    while (!q.empty()) {
        int curnode = q.front();
        q.pop();
        alive[curnode] = 0;
        
        for (int nxtnode : graphlist[curnode]) {
            if (alive[nxtnode]) {
                degree[nxtnode]--;
                
                if (degree[nxtnode] == 1 && difflist[nxtnode] == 0){
                     q.push(nxtnode);
                }
            }
        }
    }

    bestpath.clear();
    maxsum = -1e18;

    for (int i =0;  i < numofvals; i ++) {
        if (!alive[i]) continue;
        curpath.clear();
        
        dfsiz(i, -1);
        dfsgen(i, -1, 0);
        
        ll cursum = 0;
        for (int curnode : curpath){
             cursum += difflist[curnode];
        }
        
        if (cursum > maxsum) {
            maxsum = cursum;
            bestpath = curpath;
        }
    }

    if (bestpath.empty()){
         return {{0}, {0}};
    }

    vector<ll> finalans(bestpath.size(), 0);
    vector<ll> remvals(lista.begin(), lista.end());
    vector<int> lastseen(numofvals, -1);
    
    for (int i =0;  i < (int)bestpath.size(); i ++){
         lastseen[bestpath[i]] = i;
    }

    for (int i =0;  i < (int)bestpath.size(); i ++) {
        
        int curnode = bestpath[i];
        finalans[i] -= remvals[curnode];
        remvals[curnode] = 0;
        
        if (i == lastseen[curnode]){
             finalans[i] += listb[curnode];
        }
    }

    return {bestpath, finalans};
}